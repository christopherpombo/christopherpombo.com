---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["card", className]}>
  <slot />
</div>

<style>
  .card {
    background: var(--color-surface);
    border: var(--border);
    padding: var(--space-5);
    height: 100%;
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition-fast);
  }

  @media (max-width: 520px) {
    .card {
      padding: var(--space-4);
    }
  }
</style>
