---
/**
 * The "cp" mark: public/mark.svg, generated by scripts/generate-brand-assets.mjs
 * from src/data/brand.json. The SVG's canvas is tile + shadow, so the box is
 * sized from the same numbers to keep the tile at exactly `tilePx`.
 */
import brand from "../data/brand.json";
import { versioned } from "../data/versioned";

interface Props {
  /** Rendered tile size in CSS px; the shadow adds to it. */
  tilePx?: number;
  class?: string;
}

const { tilePx = brand.header.tilePx, class: className } = Astro.props;
const size = (tilePx * (brand.mark.tile + brand.mark.shadow)) / brand.mark.tile;
---

<img class={className} src={versioned("/mark.svg")} width={size} height={size} alt="" />
