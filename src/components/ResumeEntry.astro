---
interface Props {
  date: string;
  role: string;
  org: string;
  location: string;
}

const { date, role, org, location } = Astro.props;
---

<div class="resume-entry">
  <div class="resume-entry__meta">
    <p class="label">{date}</p>
    <h3 class="resume-entry__role">{role}</h3>
    <p class="resume-entry__org">{org}</p>
    <p class="mono resume-entry__location">{location}</p>
  </div>
  <div class="resume-entry__description">
    <slot />
  </div>
</div>

<style>
  .resume-entry {
    display: grid;
    grid-template-columns: minmax(200px, 1fr) 2fr;
    gap: var(--space-5);
  }

  .resume-entry__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .resume-entry__role {
    font-size: var(--font-size-h3);
    margin-top: var(--space-1);
  }

  .resume-entry__org {
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .resume-entry__location {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  @media (max-width: 640px) {
    .resume-entry {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
