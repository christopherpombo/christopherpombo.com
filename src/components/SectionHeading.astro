---
import Highlight from "./Highlight.astro";
import { splitOnWord, type HighlightOptions } from "../data/highlight";

interface Props {
  text: string;
  /** Shown in red before the label, e.g. "01" renders "01 — ABOUT". */
  number?: string;
  level?: "h2" | "h3";
  /** One word of `text` to mark with the highlighter. */
  highlight?: HighlightOptions;
}

const { text, number, level = "h2", highlight } = Astro.props;
const Tag = level;
const parts = highlight ? splitOnWord(text, highlight.word) : undefined;
---

<div class="section-heading">
  <Tag class="section-heading__label">
    {/* Decorative: hidden from screen readers and from search snippets. */}
    {number && <span class="section-heading__number" aria-hidden="true" data-nosnippet>{`${number} — `}</span>}
    {parts ? <>{parts[0]}<Highlight color={highlight!.color}>{parts[1]}</Highlight>{parts[2]}</> : text}
  </Tag>
  <span class="section-heading__rule" aria-hidden="true"></span>
  <slot name="trailing" />
</div>

<style>
  .section-heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin-bottom: var(--space-4);
  }

  .section-heading__label {
    font-family: var(--font-mono);
    font-size: var(--font-size-small);
    font-weight: 600;
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
    color: var(--color-ink);
    line-height: 1.4;
  }

  .section-heading__number {
    color: var(--color-accent);
  }

  .section-heading__rule {
    flex: 1 1 40px;
    height: 0;
    border-top: var(--border);
  }
</style>
