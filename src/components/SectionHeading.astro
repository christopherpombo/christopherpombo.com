---
interface Props {
  text: string;
  number?: string;
  level?: "h2" | "h3";
}

const { text, number, level = "h2" } = Astro.props;
const Tag = level;
---

<div class="section-heading">
  <Tag class="section-heading__label">
    {number && <span class="section-heading__number">{number} —</span>}
    {text}
  </Tag>
  <span class="section-heading__rule" aria-hidden="true"></span>
  <slot name="trailing" />
</div>

<style>
  .section-heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin-bottom: var(--space-4);
  }

  .section-heading__label {
    font-family: var(--font-mono);
    font-size: var(--font-size-small);
    font-weight: 600;
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
    color: var(--color-ink);
    line-height: 1.4;
  }

  .section-heading__number {
    color: var(--color-accent);
  }

  .section-heading__rule {
    flex: 1 1 40px;
    height: 0;
    border-top: var(--border);
  }
</style>
