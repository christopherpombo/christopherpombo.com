---
import type { CollectionEntry } from "astro:content";
import PhoneTrio from "./PhoneTrio.astro";
import { projectScreenshots } from "../data/project-screenshots";

interface Props {
  project: CollectionEntry<"projects">;
  linkLabel: string;
  /** Load the screenshots up front (set for a card above the fold). */
  eager?: boolean;
}

const { project, linkLabel, eager = false } = Astro.props;
const { title, stack, summary } = project.data;
const screenshots = projectScreenshots(project.id, title);
---

<article class:list={["project-card", { "project-card--text-only": screenshots.length === 0 }]}>
  <div class="project-card__text">
    <p class="label">{stack.join(" · ")}</p>
    <h3 class="project-card__title">{title}</h3>
    <p>{summary}</p>
    <a class="project-card__link" href={`/projects/${project.id}`}>{linkLabel}</a>
  </div>

  {
    screenshots.length > 0 && (
      <div class="project-card__visual">
        <PhoneTrio shots={screenshots} eager={eager} />
      </div>
    )
  }
</article>

<style>
  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: var(--color-surface);
    border: var(--border);
  }

  .project-card--text-only {
    grid-template-columns: 1fr;
  }

  .project-card__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5);
  }

  .project-card__title {
    font-size: var(--font-size-h2);
    font-weight: 700;
  }

  .project-card__link {
    align-self: flex-start;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--font-size-meta);
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
  }

  .project-card__link:hover {
    color: var(--color-accent);
  }

  .project-card__visual {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-6) var(--space-5);
  }

  /* The divider stops short of the card's border instead of running into it. */
  .project-card__visual::before {
    content: "";
    position: absolute;
    top: var(--space-5);
    bottom: var(--space-5);
    left: 0;
    border-left: var(--border-width) dashed var(--color-ink);
  }

  @media (max-width: 820px) {
    .project-card {
      grid-template-columns: 1fr;
    }

    .project-card__text {
      padding: var(--space-5) var(--space-4);
    }

    .project-card__visual {
      padding: var(--space-6) var(--space-4);
    }

    .project-card__visual::before {
      top: 0;
      bottom: auto;
      left: var(--space-5);
      right: var(--space-5);
      border-left: 0;
      border-top: var(--border-width) dashed var(--color-ink);
    }
  }
</style>
