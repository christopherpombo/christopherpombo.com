---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<header class="page-header">
  <p class="label page-header__eyebrow">{subtitle}</p>
  <h1>{title}</h1>
</header>

<style>
  .page-header {
    padding-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .page-header__eyebrow {
    max-width: none;
    margin-bottom: var(--space-3);
  }
</style>
