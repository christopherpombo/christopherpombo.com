---
import Highlight from "./Highlight.astro";
import { splitOnWord, type HighlightOptions } from "../data/highlight";

interface Props {
  title: string;
  subtitle: string;
  /** One word of `title` to mark with the highlighter. */
  highlight?: HighlightOptions;
}

const { title, subtitle, highlight } = Astro.props;
const parts = highlight ? splitOnWord(title, highlight.word) : undefined;
---

<header class="page-header">
  <p class="label page-header__eyebrow">{subtitle}</p>
  <h1>{parts ? <>{parts[0]}<Highlight color={highlight!.color}>{parts[1]}</Highlight>{parts[2]}</> : title}</h1>
</header>

<style>
  .page-header {
    padding-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .page-header__eyebrow {
    max-width: none;
    margin-bottom: var(--space-3);
  }
</style>
