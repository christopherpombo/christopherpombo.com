---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/tokens.css";
import "../styles/global.css";
import plexSans400Url from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import plexSans700Url from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-700-normal.woff2?url";
import plexMono400Url from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import BrandMark from "../components/BrandMark.astro";
import { contactLinks } from "../data/links";
import { publishedProjects } from "../data/projects";
import { versioned } from "../data/versioned";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const {
  title,
  description = "Christopher Pombo — work and projects.",
  image = versioned("/og-image.png"),
  type = "website",
} = Astro.props;

const currentPath = Astro.url.pathname;

// Real pages, no anchors. Projects also lights up on every /projects/* page.
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects", section: true },
  { href: "/contact", label: "Contact" },
];

const isCurrentPage = (href: string) => currentPath === href || currentPath === `${href}/`;
const isActive = (href: string, section?: boolean) =>
  isCurrentPage(href) || Boolean(section && currentPath.startsWith(`${href}/`));

// The footer repeats the nav and adds each project, so every page is one click away.
const projects = await publishedProjects();
const footerLinks = [
  { href: "/", label: "About" },
  { href: "/projects", label: "Work" },
  ...projects.map((entry) => ({ href: `/projects/${entry.id}`, label: entry.data.title })),
  { href: "/contact", label: "Contact" },
];

const canonicalUrl = new URL(currentPath, Astro.site);
const ogImageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/png" sizes="192x192" href={versioned("/favicon-192.png")} />
    <link rel="icon" type="image/svg+xml" href={versioned("/favicon.svg")} />
    <link rel="alternate icon" type="image/x-icon" href={versioned("/favicon.ico")} />
    <link rel="apple-touch-icon" href={versioned("/apple-touch-icon.png")} />

    <link rel="preload" as="font" type="font/woff2" href={plexSans400Url} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={plexSans700Url} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={plexMono400Url} crossorigin="anonymous" />

    <meta name="theme-color" content="#f7f9fc" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Christopher Pombo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner container">
        <a class="brand" href="/">
          <BrandMark class="brand__mark" />
          <span>Christopher Pombo</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <ul>
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class:list={{ "is-active": isActive(link.href, link.section) }}
                    aria-current={isCurrentPage(link.href) ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner container">
        <p>&copy; 2026 Christopher Pombo</p>
        <nav aria-label="Footer">
          <ul class="footer-links">
            {footerLinks.map((link) => (
              <li>
                <a href={link.href} aria-current={isCurrentPage(link.href) ? "page" : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <ul class="footer-links">
          {contactLinks.map((link) => (
            <li>
              <a
                href={link.href}
                {...(link.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .site-header {
    border-bottom: var(--border);
    background: var(--color-paper);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    color: var(--color-ink);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--color-accent);
  }

  /* Rendered by BrandMark, so the scoped selector needs :global. */
  .brand :global(.brand__mark) {
    flex-shrink: 0;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    gap: var(--space-2) var(--space-4);
    padding: 0;
  }

  .site-nav a {
    font-family: var(--font-mono);
    font-size: var(--font-size-label);
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink);
    padding-block: var(--space-1);
    border-bottom: var(--border-width) solid transparent;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .site-nav a:hover {
    color: var(--color-accent);
  }

  .site-nav a.is-active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .site-main {
    flex: 1;
    padding-block: var(--space-6) var(--space-8);
  }

  .site-footer {
    border-top: var(--border);
    background: var(--color-paper);
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--font-size-label);
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    padding: 0;
  }

  .footer-links a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 720px) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
      padding-block: var(--space-3);
    }

    .site-nav ul {
      gap: var(--space-1) var(--space-3);
    }
  }
</style>
