---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { contactLinks, email } from "../data/links";

const [mail, linkedIn] = contactLinks;
---

<BaseLayout title="Contact — Christopher Pombo" description="Email Christopher Pombo or find him on LinkedIn.">
  <PageHeader
    title="Contact"
    subtitle="Questions about an app, or anything else."
    highlight={{ word: "Contact", color: "pink" }}
  />

  <ul class="contact-list">
    <li>
      <span class="mono contact-list__label">Email</span>
      <a href={mail.href}>{email}</a>
    </li>
    <li>
      <span class="mono contact-list__label">LinkedIn</span>
      <a href={linkedIn.href} target="_blank" rel="noopener noreferrer">Christopher Pombo</a>
    </li>
  </ul>
</BaseLayout>

<style>
  .contact-list {
    list-style: none;
    max-width: 40rem;
    padding: var(--space-2) var(--space-5);
    background: var(--color-surface);
    border: var(--border);
  }

  .contact-list li {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    padding-block: var(--space-4);
  }

  .contact-list li + li {
    border-top: var(--rule);
  }

  .contact-list__label {
    flex: 0 0 6rem;
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
  }

  .contact-list a {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration-color: var(--color-grid);
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
  }

  .contact-list a:hover {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  @media (max-width: 520px) {
    .contact-list {
      padding-inline: var(--space-4);
    }
  }
</style>
