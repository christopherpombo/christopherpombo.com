---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("goals");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Accomplished entries always have a real historical date, so it's safe to fall
// back to the formatted `date`. Active entries without a dateLabel haven't had a
// real target set yet — showing the raw `date` there would invent a value that
// was never confirmed, so the line is hidden instead (matches the goals index).
const showDate = Boolean(entry.data.dateLabel) || entry.data.category === "done";
const dateLabel =
  entry.data.dateLabel ??
  entry.data.date.toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
---

<BaseLayout title={`${entry.data.title} — Christopher Pombo`} description={entry.data.summary}>
  <article class="goal-detail">
    <a class="back-link" href="/goals">&larr; Back to Goals</a>
    <div class="goal-detail__meta">
      {showDate && <p class="label">{dateLabel}</p>}
      {
        entry.data.result && (
          <p class="label goal-detail__result">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            {entry.data.result}
          </p>
        )
      }
    </div>
    <h1>{entry.data.title}</h1>
    <div class="goal-detail__body">
      <Content />
      <ul class="chips goal-detail__tag">
        <li>{entry.data.tag}</li>
      </ul>
    </div>
  </article>
</BaseLayout>

<style>
  .goal-detail {
    max-width: 70ch;
    padding-top: var(--space-4);
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--font-size-label);
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: var(--space-5);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .goal-detail__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-3);
  }

  .goal-detail__result {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .goal-detail__body {
    margin-top: var(--space-5);
    background: var(--color-surface);
    border: var(--border);
    padding: var(--space-5);
  }

  .goal-detail__body :global(a) {
    color: var(--color-accent);
  }

  .goal-detail__body :global(p + p) {
    margin-top: var(--space-3);
  }

  .goal-detail__tag {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: var(--rule);
  }

  @media (max-width: 520px) {
    .goal-detail__body {
      padding: var(--space-4);
    }
  }
</style>
