---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projectScreenshots } from "../../data/project-screenshots";

export async function getStaticPaths() {
  const entries = await getCollection("projects");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const year = entry.data.date.toLocaleDateString("en-US", { year: "numeric", timeZone: "UTC" });

const screenshots = projectScreenshots(entry.id, entry.data.title);
---

<BaseLayout title={`${entry.data.title} — Christopher Pombo`} description={entry.data.summary}>
  <article class="project-detail">
    <div class="project-detail__text">
      <a class="back-link" href="/projects">&larr; Back to Projects</a>
      <h1>{entry.data.title}</h1>
      <p class="label project-detail__year">{year}</p>

      <ul class="chips">
        {entry.data.stack.map((tech) => <li>{tech}</li>)}
      </ul>
    </div>

    {
      screenshots.length > 0 && (
        <div class="project-detail__screenshots">
          {screenshots.map(({ image, alt }) => (
            <div class="device">
              <Image
                src={image}
                alt={alt}
                width={600}
                densities={[1, 2]}
                loading="eager"
              />
            </div>
          ))}
        </div>
      )
    }

    <div class="project-detail__text">
      <div class="project-detail__body">
        <Content />
      </div>

      {
        entry.data.links && (
          <div class="project-detail__links">
            {entry.data.links.github && (
              <a class="btn" href={entry.data.links.github} target="_blank" rel="noopener noreferrer">
                GitHub
              </a>
            )}
            {entry.data.links.appStore && (
              <a class="btn" href={entry.data.links.appStore} target="_blank" rel="noopener noreferrer">
                App Store
              </a>
            )}
            {entry.data.links.live && (
              <a class="btn" href={entry.data.links.live} target="_blank" rel="noopener noreferrer">
                Live
              </a>
            )}
          </div>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .project-detail__text {
    max-width: 70ch;
  }

  .project-detail__text + .project-detail__text {
    margin-top: var(--space-5);
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--font-size-label);
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: var(--space-4);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .project-detail__year {
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .project-detail__screenshots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    max-width: 900px;
    margin-block: var(--space-6);
  }

  .project-detail__body {
    background: var(--color-surface);
    border: var(--border);
    padding: var(--space-5);
  }

  .project-detail__body :global(p + p) {
    margin-top: var(--space-3);
  }

  .project-detail__body :global(a) {
    color: var(--color-accent);
  }

  .project-detail__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  @media (max-width: 720px) {
    .project-detail__screenshots {
      grid-template-columns: 1fr;
      max-width: 300px;
      margin-inline: auto;
    }
  }
</style>
