---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Projects — Christopher Pombo"
  description="Software projects built by Christopher Pombo: Simply Spend, a native iOS expense tracker, and RuBric, a personal iOS app that turns Notion goals into brick walls."
>
  <PageHeader title="What I'm Building" subtitle="A page dedicated to my projects." />

  <h2 class="visually-hidden">Projects</h2>
  <div class="project-list">
    {projects.map((entry, i) => <ProjectCard project={entry} linkLabel="Read more →" eager={i === 0} />)}
  </div>
</BaseLayout>

<style>
  .project-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
</style>
