---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { publishedProjects } from "../data/projects";

const projects = await publishedProjects();
const titles = projects.map((entry) => entry.data.title);
---

<BaseLayout
  title="Projects — Christopher Pombo"
  description={`Apps by Christopher Pombo: ${titles.join(", ")}.`}
>
  <PageHeader title="Projects" subtitle="Apps by Christopher Pombo." />

  <h2 class="visually-hidden">All projects</h2>
  <div class="project-list">
    {projects.map((entry, i) => <ProjectCard project={entry} linkLabel="Read the case study →" eager={i === 0} />)}
  </div>
</BaseLayout>

<style>
  .project-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
</style>
