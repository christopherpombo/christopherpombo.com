---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { about } from "../data/about";
import { bodyMind } from "../data/body-mind";
import { contactLinks } from "../data/links";

const heroPhotoAlts: Record<string, string> = {
  "01-headshot": "Christopher Pombo",
  "02-sword-and-shield": "Christopher Pombo in his Air Force Academy jacket",
  "03-brazil-jerseys": "Christopher Pombo with a friend",
  "04-desert-ride": "Christopher Pombo mountain biking in the desert",
  "05-black-and-white": "Christopher Pombo with a friend at an event",
  "06-academy-flight-suits": "Christopher Pombo with friends in flight suits at the Air Force Academy",
  "07-ocp-beret": "Christopher Pombo in uniform",
};
const heroPhotoImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/hero-photos/*.{jpg,jpeg,png}",
  { eager: true }
);
const heroPhotos = Object.entries(heroPhotoImages)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const key = path.split("/").pop()?.replace(/\.[^.]+$/, "") ?? "";
    return { image: mod.default, alt: heroPhotoAlts[key] ?? "Christopher Pombo" };
  });

// Keyframe percentages depend on how many photos there are, so they're generated:
// each photo holds for PHOTO_SECONDS and crossfades into the next over FADE_SECONDS.
const PHOTO_SECONDS = 4;
const FADE_SECONDS = 1;
const wheelCycle = heroPhotos.length * PHOTO_SECONDS;
const pct = (seconds: number) => `${((seconds / wheelCycle) * 100).toFixed(3)}%`;
const wheelKeyframes =
  heroPhotos.length > 1
    ? `@keyframes photo-cycle{0%,${pct(PHOTO_SECONDS - FADE_SECONDS)}{opacity:1}` +
      `${pct(PHOTO_SECONDS)},${pct(wheelCycle - FADE_SECONDS)}{opacity:0}100%{opacity:1}}`
    : "";
const wheelDelay = (i: number) => -((heroPhotos.length - i) % heroPhotos.length) * PHOTO_SECONDS;

const allGoals = await getCollection("goals");

const activeGoals = allGoals
  .filter((entry) => entry.data.category === "active")
  .sort(
    (a, b) =>
      a.data.date.valueOf() - b.data.date.valueOf() || (a.data.order ?? 99) - (b.data.order ?? 99)
  );

const completedGoals = allGoals
  .filter((entry) => entry.data.category === "done")
  .sort(
    (a, b) =>
      b.data.date.valueOf() - a.data.date.valueOf() || (a.data.order ?? 99) - (b.data.order ?? 99)
  );

const formatMonth = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });

const projects = await getCollection("projects");
const featuredProject = projects.find((entry) => entry.id === "simply-spend");

const ledgers = bodyMind
  .map((card) => ({ ...card, rows: card.rows.filter((row) => row.value) }))
  .filter((card) => card.rows.length > 0);

// Active goals without a dateLabel only carry a placeholder sort date, so no date is shown.
const goalWhen = (entry: (typeof allGoals)[number]) =>
  entry.data.dateLabel ?? (entry.data.category === "done" ? formatMonth(entry.data.date) : "");

const external = (href: string) =>
  href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<BaseLayout
  title="Christopher Pombo — 2d Lt, iOS Developer, Runner"
  description="Christopher Pombo — 2d Lt in the Air Force Medical Service Corps, iOS developer, and runner. What I'm chasing, what I've built, and what I've finished."
  compactFooter
>
  <section class="hero">
    <div class="hero-text">
      <p class="label">A page dedicated to my interests &amp; ambitions.</p>
      <h1>I take on challenges that scare me, then build my way through them.</h1>
      <p class="hero-intro">
        2d Lt in the Air Force Medical Service Corps, iOS developer, and runner. This is where I
        keep track of what I'm chasing and what I've finished.
      </p>
      <div class="hero-buttons">
        <a class="btn btn--primary" href="/projects">See what I'm building</a>
        <a class="btn" href="/contact">Get in touch</a>
      </div>
    </div>

    {
      heroPhotos.length > 0 && (
        <figure class="hero-photo">
          <div class="photo-card">
            <div class="photo-wheel" style={`--wheel-cycle: ${wheelCycle}s`}>
              {heroPhotos.map((photo, i) => (
                <Image
                  style={`--wheel-delay: ${wheelDelay(i)}s`}
                  src={photo.image}
                  alt={photo.alt}
                  width={480}
                  densities={[1, 2]}
                  loading={i === 0 ? "eager" : "lazy"}
                />
              ))}
            </div>
            {wheelKeyframes && <style is:inline set:html={wheelKeyframes} />}
          </div>
          <figcaption class="hand hero-photo__note">← bite off more than you can chew</figcaption>
        </figure>
      )
    }
  </section>

  {
    about.length > 0 && (
      <section class="section" id="who">
        <SectionHeading number="01" text="Who I am">
          <a slot="trailing" class="section-link" href="/resume">Resume →</a>
        </SectionHeading>
        <div class="panel about-grid">
          {about.map((item) => (
            <div class="about-item">
              <p class="label">{item.label}</p>
              <p class="about-item__title">{item.title}</p>
              {item.meta && <p class="mono about-item__meta">{item.meta}</p>}
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    activeGoals.length > 0 && (
      <section class="section" id="doing">
        <SectionHeading number="02" text="What I'm doing">
          <a slot="trailing" class="section-link" href="/goals">All goals →</a>
        </SectionHeading>
        <div class="index-cards">
          {activeGoals.map((entry) => (
            <a class="index-card" href={`/goals/${entry.id}`}>
              {goalWhen(entry) && <p class="label">{goalWhen(entry)}</p>}
              <h3 class="index-card__title">{entry.data.title}</h3>
              <p class="index-card__summary">{entry.data.summary}</p>
              {entry.data.next && (
                <p class="mono index-card__next">
                  <span>Next →</span> {entry.data.next}
                </p>
              )}
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    featuredProject && (
      <section class="section" id="built">
        <SectionHeading number="03" text="What I've built">
          <a slot="trailing" class="section-link" href="/projects">All projects →</a>
        </SectionHeading>
        <ProjectCard project={featuredProject} linkLabel="Read the case study →" showStoreStatus eager />
      </section>
    )
  }

  {
    ledgers.length > 0 && (
      <section class="section" id="body-mind">
        <SectionHeading number="04" text="Strengthen body, strengthen mind" />
        <div class="body-mind">
          {ledgers.map((card) => (
            <div class="panel ledger-card">
              <h3 class="ledger-card__title">{card.title}</h3>
              <dl class="ledger">
                {card.rows.map((row) => (
                  <div class="ledger__row">
                    <dt class="mono">{row.label}</dt>
                    <dd>{row.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    completedGoals.length > 0 && (
      <section class="section" id="completed">
        <SectionHeading number="05" text="Completed" note="one at a time">
          <a slot="trailing" class="section-link" href="/goals#done">All goals →</a>
        </SectionHeading>
        <ol class="panel rocks">
          {completedGoals.map((entry) => (
            <li>
              <a class="rock" href={`/goals/${entry.id}`}>
                <span class="mono rock__date">{goalWhen(entry)}</span>
                <span class="rock__title">{entry.data.title}</span>
                {entry.data.result && (
                  <span class="label rock__result">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    {entry.data.result}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="closing">
    <h2 class="closing__title">Start before you're ready.</h2>
    <p class="closing__line">Working on something hard? I'd like to hear about it.</p>
    <ul class="closing__links">
      {
        contactLinks.map((link) => (
          <li>
            <a class="mono" href={link.href} {...external(link.href)}>
              {link.label} →
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    gap: var(--space-7);
    align-items: center;
    padding-block: var(--space-4) var(--space-8);
  }

  .hero-text .label {
    margin-bottom: var(--space-4);
  }

  .hero-text h1 {
    font-size: clamp(2.25rem, 3vw + 1.25rem, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .hero-intro {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 52ch;
    margin-bottom: var(--space-5);
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-photo {
    margin: 0;
    padding: 0 6px 6px 0;
  }

  .photo-card {
    background: var(--color-surface);
    border: var(--border);
    box-shadow: var(--shadow-hard);
    padding: var(--space-2);
    transform: rotate(1.5deg);
  }

  .photo-wheel {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .photo-wheel :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: photo-cycle var(--wheel-cycle) infinite;
    animation-delay: var(--wheel-delay, 0s);
  }

  .photo-wheel :global(img:first-child) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-wheel :global(img) {
      animation: none;
      opacity: 0;
    }

    .photo-wheel :global(img:first-child) {
      opacity: 1;
    }
  }

  .hero-photo__note {
    margin-top: var(--space-4);
    padding-left: var(--space-2);
    transform: rotate(-2deg);
  }

  /* ---------- Shared section bits ---------- */
  .section {
    margin-bottom: var(--space-8);
  }

  .panel {
    background: var(--color-surface);
    border: var(--border);
    padding: var(--space-5);
  }

  .section-link {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--font-size-label);
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .section-link:hover {
    text-decoration: underline;
  }

  /* ---------- 01 Who I am ---------- */
  .about-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .about-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-3);
    border-left: var(--border-width) solid var(--color-grid);
  }

  .about-item__title {
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .about-item__meta {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
  }

  /* ---------- What I'm doing: index cards ---------- */
  .index-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--space-5);
    padding: var(--space-1) 6px 6px 0;
  }

  .index-card {
    --tilt: 0deg;
    --rule-gap: 1.6rem;
    --pad-left: calc(20px + var(--space-3));
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-4) var(--space-4) var(--space-4) var(--pad-left);
    border: var(--border);
    box-shadow: var(--shadow-hard);
    background-color: var(--color-surface);
    background-image: linear-gradient(
      90deg,
      transparent 19px,
      var(--color-accent) 19px,
      var(--color-accent) 20px,
      transparent 20px
    );
    color: inherit;
    text-decoration: none;
    transform: rotate(var(--tilt));
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .index-card:nth-child(3n + 1) {
    --tilt: -0.6deg;
  }

  .index-card:nth-child(3n) {
    --tilt: 0.6deg;
  }

  .index-card:hover {
    transform: translate(-2px, -3px);
    box-shadow: 8px 9px 0 var(--color-ink);
  }

  .index-card__title {
    font-size: var(--font-size-h3);
    line-height: 1.25;
    transition: color var(--transition-fast);
  }

  .index-card:hover .index-card__title {
    color: var(--color-accent);
  }

  /* The ruled lines live on the summary so each line of text sits on one;
     it grows to fill the card and bleeds to both edges like a real card. */
  .index-card__summary {
    flex-grow: 1;
    max-width: none;
    margin-inline: calc(-1 * var(--pad-left)) calc(-1 * var(--space-4));
    padding-inline: var(--pad-left) var(--space-4);
    line-height: var(--rule-gap);
    color: var(--color-text-muted);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(var(--rule-gap) - 1px),
      var(--color-grid) calc(var(--rule-gap) - 1px),
      var(--color-grid) var(--rule-gap)
    );
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .index-card__next {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--font-size-label);
    color: var(--color-ink);
  }

  .index-card__next span {
    color: var(--color-accent);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .index-card,
    .index-card:hover {
      transform: none;
      transition: none;
    }
  }

  /* ---------- Body & mind ---------- */
  .body-mind {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .ledger-card__title {
    font-size: var(--font-size-h3);
    margin-bottom: var(--space-3);
  }

  .ledger__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-top: var(--rule);
  }

  .ledger__row dt {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .ledger__row dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }

  /* ---------- Completed ---------- */
  .rocks {
    list-style: none;
    padding-block: var(--space-2);
  }

  .rocks li + li {
    border-top: var(--rule);
  }

  .rock {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    text-decoration: none;
    color: inherit;
  }

  .rock__date {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
  }

  .rock__title {
    font-weight: 700;
    color: var(--color-ink);
    transition: color var(--transition-fast);
  }

  .rock:hover .rock__title {
    color: var(--color-accent);
  }

  .rock__result {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    white-space: nowrap;
  }

  .rock__result svg {
    align-self: center;
  }

  /* ---------- Closing ---------- */
  .closing {
    padding-block: var(--space-6) var(--space-4);
    border-top: var(--border);
  }

  .closing__title {
    font-size: clamp(2.25rem, 4vw + 1rem, 4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .closing__line {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .closing__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    list-style: none;
    padding: 0;
  }

  .closing__links a {
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
  }

  .closing__links a:hover {
    color: var(--color-accent);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .about-grid,
    .index-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .index-card:nth-child(n) {
      --tilt: 0deg;
    }

    .index-card:nth-child(4n + 1) {
      --tilt: -0.6deg;
    }

    .index-card:nth-child(4n + 2) {
      --tilt: 0.6deg;
    }
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-bottom: var(--space-7);
    }

    .hero-photo {
      max-width: 300px;
      margin-inline: auto;
    }

    .body-mind {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .section {
      margin-bottom: var(--space-7);
    }

    .panel {
      padding: var(--space-4);
    }

    .about-grid,
    .index-cards {
      grid-template-columns: 1fr;
    }

    .index-cards {
      grid-auto-rows: auto;
    }

    .index-card:nth-child(n) {
      --tilt: 0deg;
    }

    .index-card:nth-child(odd) {
      --tilt: -0.6deg;
    }

    .index-card:nth-child(even) {
      --tilt: 0.6deg;
    }

    .rock {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "date result"
        "title title";
      gap: var(--space-1) var(--space-3);
    }

    .rock__date {
      grid-area: date;
    }

    .rock__title {
      grid-area: title;
    }

    .rock__result {
      grid-area: result;
    }
  }
</style>
