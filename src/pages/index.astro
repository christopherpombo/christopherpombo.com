---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Card from "../components/Card.astro";
import CardTitle from "../components/CardTitle.astro";
import SocialIcons from "../components/SocialIcons.astro";
import { goalStats } from "../data/goal-stats";

const headshotImages = import.meta.glob<{ default: ImageMetadata }>("/src/assets/headshot.*", {
  eager: true,
});
const headshot = Object.values(headshotImages)[0]?.default;

const heroStats = goalStats.slice(0, 3);

const allGoals = await getCollection("goals");
const currentGoals = allGoals
  .filter((entry) => entry.data.category === "active" && entry.data.current)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const projects = await getCollection("projects");
const featuredProject = projects.find((entry) => entry.id === "simply-spend");

const projectImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/**/*.{jpg,jpeg,png,webp}",
  { eager: true }
);
const featuredScreenshots = featuredProject
  ? Object.entries(projectImages)
      .filter(([path]) => path.includes(`/${featuredProject.id}/`) || path.includes(`/${featuredProject.id}.`))
      .sort(([a], [b]) => a.localeCompare(b))
      .map(([, mod]) => mod.default)
  : [];
---

<BaseLayout
  title="Home — Christopher Pombo"
  description="Christopher Pombo — 2d Lt, USAF Medical Service Corps officer and iOS developer, building Simply Spend and chasing goals in the open."
>
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">Hi, I'm Christopher</p>
      <h1>I take on challenges that scare me, then build my way through them.</h1>
      <p class="hero-subtitle">2d Lt, USAF Medical Service Corps · iOS Developer</p>
      <p class="hero-intro">
        I'm a healthcare administration officer at Travis AFB who teaches himself things on the
        side, like building iOS apps and running marathons. This site is where I keep track of
        what I'm building and what's next.
      </p>

      <div class="hero-buttons">
        <a class="btn btn--primary" href="/projects">See what I'm building</a>
        <a class="btn" href="/contact">Get in touch</a>
      </div>

      {
        heroStats.length > 0 && (
          <div class="hero-stats">
            {heroStats.map((stat) => (
              <div class="hero-stat">
                <p class="hero-stat__value">{stat.value}</p>
                <p class="hero-stat__label">{stat.label}</p>
              </div>
            ))}
          </div>
        )
      }
    </div>

    <div class="hero-photo">
      <Card>
        {
          headshot ? (
            <Image src={headshot} alt="Christopher Pombo" width={480} densities={[1, 2]} loading="eager" />
          ) : (
            <div class="hero-photo__placeholder" role="img" aria-label="Christopher Pombo headshot placeholder">
              <svg viewBox="0 0 24 24" width="64" height="64" fill="currentColor" aria-hidden="true">
                <path d="M12 12c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm0 2c-3.33 0-10 1.67-10 5v3h20v-3c0-3.33-6.67-5-10-5z" />
              </svg>
            </div>
          )
        }
      </Card>
      <div class="hero-photo__social">
        <SocialIcons />
      </div>
    </div>
  </section>

  {
    currentGoals.length > 0 && (
      <section class="section currently-section">
        <SectionHeading text="Currently">
          <a slot="trailing" class="section-link" href="/goals">
            All goals →
          </a>
        </SectionHeading>
        <Card>
          <div class="currently-grid">
            {currentGoals.map((entry) => (
              <a class="currently-item" href={`/goals/${entry.id}`}>
                <p class="currently-label">{entry.data.current}</p>
                <p class="currently-title">{entry.data.title}</p>
                {entry.data.dateLabel && <p class="currently-meta">{entry.data.dateLabel}</p>}
              </a>
            ))}
          </div>
        </Card>
      </section>
    )
  }

  {
    featuredProject && (
      <section class="section">
        <SectionHeading text="Featured project" />
        <Card>
          <div class="featured-grid">
            <div class="featured-text">
              <CardTitle title={featuredProject.data.title} />
              <p>{featuredProject.data.summary}</p>
              <ul class="stack-tags">
                {featuredProject.data.stack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
              <div class="featured-actions">
                {featuredProject.data.links?.appStore ? (
                  <a
                    class="btn btn--primary"
                    href={featuredProject.data.links.appStore}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    App Store
                  </a>
                ) : (
                  <p class="featured-coming-soon">Coming to the App Store late Oct 2026</p>
                )}
                <a class="featured-case-study" href={`/projects/${featuredProject.id}`}>
                  Read the case study →
                </a>
              </div>
            </div>

            {featuredScreenshots.length > 0 && (
              <div class="featured-visual">
                {featuredScreenshots.map((img, i) => (
                  <div class="phone-frame">
                    <Image
                      src={img}
                      alt={`${featuredProject.data.title} app screenshot`}
                      width={280}
                      densities={[1, 2]}
                      loading={i === 0 ? "eager" : "lazy"}
                    />
                  </div>
                ))}
              </div>
            )}
          </div>
        </Card>
      </section>
    )
  }

  <section class="section explore-section">
    <div class="explore-grid">
      <a class="explore-card" href="/goals">
        <Card>
          <h3>Goals →</h3>
          <p>What I'm chasing now, and the trophy case of what I've done.</p>
        </Card>
      </a>
      <a class="explore-card" href="/resume">
        <Card>
          <h3>Resume →</h3>
          <p>Leadership, research, and education, from USAFA to Travis.</p>
        </Card>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 360px);
    gap: var(--space-7);
    align-items: start;
    margin-bottom: var(--space-7);
  }

  .eyebrow {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-uppercase);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }

  .hero-text h1 {
    font-size: clamp(1.875rem, 2.75vw + 1.25rem, 2.75rem);
    margin-bottom: var(--space-3);
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-uppercase);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .hero-intro {
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 60ch;
    margin-bottom: var(--space-5);
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .hero-stat__value {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--font-size-h3);
    color: var(--color-text);
  }

  .hero-stat__label {
    font-size: var(--font-size-meta);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  .hero-photo :global(.card) {
    padding: 0;
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-photo__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg);
    color: var(--color-text-muted);
  }

  .hero-photo__social {
    display: flex;
    justify-content: center;
    margin-top: var(--space-4);
  }

  .section {
    margin-bottom: var(--space-7);
  }

  .section-link {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--font-size-small);
    color: var(--color-accent);
    text-decoration: none;
  }

  .section-link:hover {
    text-decoration: underline;
  }

  .currently-section :global(.card) {
    min-height: auto;
  }

  .currently-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-2);
  }

  .currently-item {
    text-decoration: none;
    color: inherit;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-border);
    transition: border-color var(--transition-fast);
  }

  .currently-item:hover {
    border-color: var(--color-accent);
  }

  .currently-item:hover .currently-title {
    color: var(--color-accent);
  }

  .currently-label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--font-size-meta);
    letter-spacing: var(--letter-spacing-uppercase);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-1);
  }

  .currently-title {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .currently-meta {
    font-size: var(--font-size-meta);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-6);
  }

  .featured-text p {
    color: var(--color-text);
  }

  .stack-tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .stack-tags li {
    font-size: var(--font-size-meta);
    font-weight: 500;
    letter-spacing: var(--letter-spacing-uppercase);
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: var(--color-bg);
    padding: var(--space-1) var(--space-2);
    border-radius: 2px;
  }

  .featured-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .featured-coming-soon {
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
  }

  .featured-case-study {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--font-size-small);
    color: var(--color-accent);
    text-decoration: none;
  }

  .featured-case-study:hover {
    text-decoration: underline;
  }

  .featured-visual {
    background: var(--color-bg);
    border-radius: var(--radius-card);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-3);
  }

  .phone-frame {
    background: var(--color-surface);
    border-radius: 10px;
    box-shadow: var(--shadow-card);
    padding: var(--space-1);
    flex-shrink: 0;
    width: 32%;
  }

  .phone-frame:nth-child(2) {
    transform: translateY(-16px);
    width: 36%;
    z-index: 1;
  }

  .phone-frame :global(img) {
    width: 100%;
    height: auto;
    border-radius: 7px;
  }

  .explore-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .explore-card {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform var(--transition-fast);
  }

  .explore-card:hover {
    transform: translateY(-2px);
  }

  .explore-card :global(.card) {
    min-height: auto;
  }

  .explore-card h3 {
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .explore-card p {
    color: var(--color-text-muted);
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-photo {
      max-width: 320px;
      margin-inline: auto;
      order: -1;
      margin-bottom: var(--space-6);
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }

    .featured-visual {
      order: -1;
    }
  }

  @media (max-width: 640px) {
    .currently-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .explore-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
