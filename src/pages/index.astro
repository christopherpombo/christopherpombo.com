---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { bodyMind } from "../data/body-mind";
import { contactLinks } from "../data/links";
import { projectScreenshotAlts } from "../data/project-screenshot-alts";

const heroPhotoAlts: Record<string, string> = {
  "01-headshot": "Christopher Pombo",
  "02-sword-and-shield": "Christopher Pombo in his Air Force Academy jacket",
  "03-brazil-jerseys": "Christopher Pombo with a friend",
};
const heroPhotoImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/hero-photos/*.{jpg,jpeg,png}",
  { eager: true }
);
const heroPhotos = Object.entries(heroPhotoImages)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const key = path.split("/").pop()?.replace(/\.[^.]+$/, "") ?? "";
    return { image: mod.default, alt: heroPhotoAlts[key] ?? "Christopher Pombo" };
  });

const allGoals = await getCollection("goals");

const currentGoals = allGoals
  .filter((entry) => entry.data.category === "active" && entry.data.current)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const stackedRocks = allGoals
  .filter((entry) => entry.data.category === "done")
  .sort(
    (a, b) =>
      b.data.date.valueOf() - a.data.date.valueOf() || (a.data.order ?? 99) - (b.data.order ?? 99)
  );

const formatMonth = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });

const projects = await getCollection("projects");
const featuredProject = projects.find((entry) => entry.id === "simply-spend");

const projectImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/**/*.{jpg,jpeg,png,webp}",
  { eager: true }
);
const featuredScreenshots = featuredProject
  ? Object.entries(projectImages)
      .filter(([path]) => path.includes(`/${featuredProject.id}/`) || path.includes(`/${featuredProject.id}.`))
      .sort(([a], [b]) => a.localeCompare(b))
      .map(([path, mod]) => {
        const key = path.split("/").pop()?.replace(/\.[^.]+$/, "") ?? "";
        const alt = projectScreenshotAlts[key] ?? `${featuredProject.data.title} app screenshot`;
        return { image: mod.default, alt };
      })
  : [];

const ledgers = bodyMind
  .map((card) => ({ ...card, rows: card.rows.filter((row) => row.value) }))
  .filter((card) => card.rows.length > 0);

const external = (href: string) =>
  href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<BaseLayout
  title="Christopher Pombo — 2d Lt, iOS Developer, Runner"
  description="Christopher Pombo — 2d Lt in the Air Force Medical Service Corps, iOS developer, and runner. What I'm chasing, what I've built, and what I've finished."
  compactFooter
>
  <section class="hero">
    <div class="hero-text">
      <p class="label">A page dedicated to my interests &amp; ambitions.</p>
      <h1>I take on challenges that scare me, then build my way through them.</h1>
      <p class="hero-intro">
        2d Lt in the Air Force Medical Service Corps, iOS developer, and runner. This is where I
        keep track of what I'm chasing and what I've finished.
      </p>
      <div class="hero-buttons">
        <a class="btn btn--primary" href="/projects">See what I'm building</a>
        <a class="btn" href="/contact">Get in touch</a>
      </div>
    </div>

    {
      heroPhotos.length > 0 && (
        <figure class="hero-photo">
          <div class="photo-card">
            <div class="photo-wheel">
              {heroPhotos.map((photo, i) => (
                <Image
                  style={`--wheel-delay: ${-(i * 4)}s`}
                  src={photo.image}
                  alt={photo.alt}
                  width={480}
                  densities={[1, 2]}
                  loading="eager"
                />
              ))}
            </div>
          </div>
          <figcaption class="hand hero-photo__note">← bite off more than you can chew</figcaption>
        </figure>
      )
    }
  </section>

  {
    currentGoals.length > 0 && (
      <section class="section" id="doing">
        <SectionHeading number="01" text="What I'm doing">
          <a slot="trailing" class="section-link" href="/goals">All goals →</a>
        </SectionHeading>
        <div class="panel doing-grid">
          {currentGoals.map((entry) => (
            <a class="doing-item" href={`/goals/${entry.id}`}>
              <p class="label">{entry.data.current}</p>
              <p class="doing-item__title">{entry.data.title}</p>
              {entry.data.dateLabel && <p class="mono doing-item__meta">{entry.data.dateLabel}</p>}
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    featuredProject && (
      <section class="section" id="built">
        <SectionHeading number="02" text="What I've built">
          <a slot="trailing" class="section-link" href="/projects">All projects →</a>
        </SectionHeading>
        <div class="panel built">
          <div class="built__text">
            <p class="label">{featuredProject.data.stack.join(" · ")}</p>
            <h3 class="built__title">{featuredProject.data.title}</h3>
            <p>{featuredProject.data.summary}</p>
            <div class="built__actions">
              <a class="text-link" href={`/projects/${featuredProject.id}`}>
                Read the case study →
              </a>
              {featuredProject.data.links?.appStore ? (
                <a class="btn btn--primary" href={featuredProject.data.links.appStore} {...external(featuredProject.data.links.appStore)}>
                  App Store
                </a>
              ) : (
                <p class="mono built__soon">Coming to the App Store</p>
              )}
            </div>
          </div>

          {featuredScreenshots.length > 0 && (
            <div class="built__visual">
              {featuredScreenshots.map((shot, i) => (
                <div class="device">
                  <Image
                    src={shot.image}
                    alt={shot.alt}
                    width={280}
                    densities={[1, 2]}
                    loading={i === 0 ? "eager" : "lazy"}
                  />
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    ledgers.length > 0 && (
      <section class="section" id="body-mind">
        <SectionHeading number="03" text="Strengthen body, strengthen mind" />
        <div class="body-mind">
          {ledgers.map((card) => (
            <div class="panel ledger-card">
              <h3 class="ledger-card__title">{card.title}</h3>
              <dl class="ledger">
                {card.rows.map((row) => (
                  <div class="ledger__row">
                    <dt class="mono">{row.label}</dt>
                    <dd>{row.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    stackedRocks.length > 0 && (
      <section class="section" id="stacked-rocks">
        <SectionHeading number="04" text="Stacked rocks" note="one at a time">
          <a slot="trailing" class="section-link" href="/goals#done">All goals →</a>
        </SectionHeading>
        <ol class="panel rocks">
          {stackedRocks.map((entry) => (
            <li>
              <a class="rock" href={`/goals/${entry.id}`}>
                <span class="mono rock__date">{entry.data.dateLabel ?? formatMonth(entry.data.date)}</span>
                <span class="rock__title">{entry.data.title}</span>
                {entry.data.result && (
                  <span class="label rock__result">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    {entry.data.result}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="closing">
    <h2 class="closing__title">Start before you're ready.</h2>
    <p class="closing__line">Working on something hard? I'd like to hear about it.</p>
    <ul class="closing__links">
      {
        contactLinks.map((link) => (
          <li>
            <a class="mono" href={link.href} {...external(link.href)}>
              {link.label} →
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    gap: var(--space-7);
    align-items: center;
    padding-block: var(--space-4) var(--space-8);
  }

  .hero-text .label {
    margin-bottom: var(--space-4);
  }

  .hero-text h1 {
    font-size: clamp(2.25rem, 3vw + 1.25rem, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .hero-intro {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 52ch;
    margin-bottom: var(--space-5);
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-photo {
    margin: 0;
    padding: 0 6px 6px 0;
  }

  .photo-card {
    background: var(--color-surface);
    border: var(--border);
    box-shadow: var(--shadow-hard);
    padding: var(--space-2);
    transform: rotate(1.5deg);
  }

  .photo-wheel {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .photo-wheel :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: photo-cycle 12s infinite;
    animation-delay: var(--wheel-delay, 0s);
  }

  .photo-wheel :global(img:first-child) {
    opacity: 1;
  }

  @keyframes photo-cycle {
    0%,
    22% {
      opacity: 1;
    }
    33%,
    92% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-wheel :global(img) {
      animation: none;
      opacity: 0;
    }

    .photo-wheel :global(img:first-child) {
      opacity: 1;
    }
  }

  .hero-photo__note {
    margin-top: var(--space-4);
    padding-left: var(--space-2);
    transform: rotate(-2deg);
  }

  /* ---------- Shared section bits ---------- */
  .section {
    margin-bottom: var(--space-8);
  }

  .panel {
    background: var(--color-surface);
    border: var(--border);
    padding: var(--space-5);
  }

  .text-link {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--font-size-meta);
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
  }

  .text-link:hover {
    color: var(--color-accent);
  }

  .section-link {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--font-size-label);
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .section-link:hover {
    text-decoration: underline;
  }

  /* ---------- 01 What I'm doing ---------- */
  .doing-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .doing-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-3);
    border-left: var(--border-width) solid var(--color-grid);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition-fast);
  }

  .doing-item:hover {
    border-left-color: var(--color-accent);
  }

  .doing-item__title {
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.3;
    color: var(--color-ink);
    transition: color var(--transition-fast);
  }

  .doing-item:hover .doing-item__title {
    color: var(--color-accent);
  }

  .doing-item__meta {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
  }

  /* ---------- 02 What I've built ---------- */
  .built {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    padding: 0;
  }

  .built__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5);
  }

  .built__title {
    font-size: var(--font-size-h2);
    font-weight: 700;
  }

  .built__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-2);
  }

  .built__soon {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
  }

  .built__visual {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5);
    border-left: var(--border-width) dashed var(--color-ink);
  }

  .built__visual .device {
    flex-shrink: 0;
    width: 30%;
  }

  .built__visual .device:nth-child(2) {
    width: 34%;
    transform: translateY(-14px);
    z-index: 1;
  }

  /* ---------- 03 Body & mind ---------- */
  .body-mind {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .ledger-card__title {
    font-size: var(--font-size-h3);
    margin-bottom: var(--space-3);
  }

  .ledger__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-top: var(--rule);
  }

  .ledger__row dt {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .ledger__row dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }

  /* ---------- 04 Stacked rocks ---------- */
  .rocks {
    list-style: none;
    padding-block: var(--space-2);
  }

  .rocks li + li {
    border-top: var(--rule);
  }

  .rock {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    text-decoration: none;
    color: inherit;
  }

  .rock__date {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
  }

  .rock__title {
    font-weight: 700;
    color: var(--color-ink);
    transition: color var(--transition-fast);
  }

  .rock:hover .rock__title {
    color: var(--color-accent);
  }

  .rock__result {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    white-space: nowrap;
  }

  .rock__result svg {
    align-self: center;
  }

  /* ---------- Closing ---------- */
  .closing {
    padding-block: var(--space-6) var(--space-4);
    border-top: var(--border);
  }

  .closing__title {
    font-size: clamp(2.25rem, 4vw + 1rem, 4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .closing__line {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .closing__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    list-style: none;
    padding: 0;
  }

  .closing__links a {
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
  }

  .closing__links a:hover {
    color: var(--color-accent);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .doing-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-bottom: var(--space-7);
    }

    .hero-photo {
      max-width: 300px;
      margin-inline: auto;
    }

    .built {
      grid-template-columns: 1fr;
    }

    .built__text {
      padding: var(--space-5) var(--space-4);
    }

    .built__visual {
      border-left: 0;
      border-top: var(--border-width) dashed var(--color-ink);
      padding: var(--space-6) var(--space-4);
    }

    .body-mind {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .section {
      margin-bottom: var(--space-7);
    }

    .panel {
      padding: var(--space-4);
    }

    .doing-grid {
      grid-template-columns: 1fr;
    }

    .built {
      padding: 0;
    }

    /* Three phones across get too small to read here, so the middle one
       takes over and the other two tuck in behind it. */
    .built__visual .device {
      width: 34%;
    }

    .built__visual .device:first-child {
      margin-right: -15%;
      z-index: 0;
    }

    .built__visual .device:nth-child(2) {
      width: 58%;
      transform: translateY(-10px);
    }

    .built__visual .device:last-child {
      margin-left: -15%;
      z-index: 0;
    }

    .rock {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "date result"
        "title title";
      gap: var(--space-1) var(--space-3);
    }

    .rock__date {
      grid-area: date;
    }

    .rock__title {
      grid-area: title;
    }

    .rock__result {
      grid-area: result;
    }
  }
</style>
