---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhoneTrio from "../components/PhoneTrio.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { projectScreenshots } from "../data/project-screenshots";
import { publishedProjects } from "../data/projects";

const projects = await publishedProjects();
const featured = projects.find((entry) => entry.data.featured) ?? projects[0];
const shots = featured ? projectScreenshots(featured.id, featured.data.title) : [];
const appStore = featured?.data.links?.appStore;
---

<BaseLayout
  title="Christopher Pombo — Apps"
  description={featured
    ? `Apps by Christopher Pombo, including ${featured.data.title}. ${featured.data.tagline}`
    : undefined}
>
  {
    featured && (
      <section class="hero">
        <div class="hero__text">
          <p class="label">Featured app</p>
          <h1 class="hero__title">{featured.data.title}</h1>
          <p class="hero__tagline">{featured.data.tagline}</p>
          <div class="hero__actions">
            {appStore ? (
              <a class="btn btn--primary" href={appStore} target="_blank" rel="noopener noreferrer">
                App Store
              </a>
            ) : (
              <p class="mono hero__soon">Coming soon to the App Store</p>
            )}
            <a class="text-link" href={`/projects/${featured.id}`}>
              Read the case study →
            </a>
          </div>
        </div>
        {shots.length > 0 && (
          <div class="hero__visual">
            <PhoneTrio shots={shots} eager width={300} />
          </div>
        )}
      </section>
    )
  }

  {
    projects.length > 0 && (
      <section class="section" id="projects">
        <SectionHeading text="Projects">
          <a slot="trailing" class="section-link" href="/projects">
            All projects →
          </a>
        </SectionHeading>
        <ol class="project-list">
          {projects.map((entry) => (
            <li>
              <a class="project-row" href={`/projects/${entry.id}`}>
                <span class="project-row__title">{entry.data.title}</span>
                <span class="project-row__tagline">{entry.data.tagline}</span>
                <span class="mono project-row__stack">{entry.data.stack.join(" · ")}</span>
                <span class="project-row__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ---------- Hero: the featured app ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-6);
    align-items: center;
    padding-block: var(--space-4) var(--space-8);
  }

  .hero__text .label {
    margin-bottom: var(--space-3);
  }

  .hero__title {
    font-size: clamp(3rem, 5vw + 1rem, 5.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-4);
  }

  .hero__tagline {
    font-size: clamp(1.25rem, 1vw + 1rem, 1.625rem);
    line-height: 1.35;
    color: var(--color-text-muted);
    max-width: 24ch;
    margin-bottom: var(--space-5);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
  }

  .hero__soon {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
  }

  .text-link {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--font-size-meta);
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
  }

  .text-link:hover {
    color: var(--color-accent);
  }

  .hero__visual {
    padding-top: var(--space-4);
  }

  /* ---------- Projects list ---------- */
  .section {
    margin-bottom: var(--space-7);
  }

  .section-link {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--font-size-label);
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .section-link:hover {
    text-decoration: underline;
  }

  .project-list {
    list-style: none;
    padding: var(--space-2) var(--space-5);
    background: var(--color-surface);
    border: var(--border);
  }

  .project-list li + li {
    border-top: var(--rule);
  }

  .project-row {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) auto auto;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
    text-decoration: none;
    color: inherit;
  }

  .project-row__title {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-ink);
    transition: color var(--transition-fast);
  }

  .project-row__tagline {
    color: var(--color-text-muted);
  }

  .project-row__stack {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .project-row__arrow {
    font-family: var(--font-mono);
    color: var(--color-accent);
  }

  .project-row:hover .project-row__title {
    color: var(--color-accent);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      padding-bottom: var(--space-7);
    }

    .project-row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "title arrow"
        "tagline tagline"
        "stack stack";
      gap: var(--space-1) var(--space-3);
    }

    .project-row__title {
      grid-area: title;
    }

    .project-row__tagline {
      grid-area: tagline;
    }

    .project-row__stack {
      grid-area: stack;
      margin-top: var(--space-1);
    }

    .project-row__arrow {
      grid-area: arrow;
    }
  }

  @media (max-width: 640px) {
    .project-list {
      padding-inline: var(--space-4);
    }
  }
</style>
