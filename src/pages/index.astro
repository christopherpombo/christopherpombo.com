---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PhoneTrio from "../components/PhoneTrio.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Highlight from "../components/Highlight.astro";
import { findWord, splitOnWord } from "../data/highlight";
import { contactLinks } from "../data/links";
import { projectScreenshots } from "../data/project-screenshots";
import { publishedProjects } from "../data/projects";
import desertRide from "../assets/about/desert-ride.jpg";
import ocpBeret from "../assets/about/ocp-beret.jpg";
import lake from "../assets/about/lake.jpg";

const projects = await publishedProjects();
const featured = projects.find((entry) => entry.data.featured) ?? projects[0];
const others = projects.filter((entry) => entry !== featured);
const shots = featured ? projectScreenshots(featured.id, featured.data.title) : [];
const appStore = featured?.data.links?.appStore;
// The tagline is split into sentences, each kept whole, so a two-sentence
// tagline breaks between them instead of stranding a word. The highlight goes
// in whichever sentence has the word (splitOnWord fails the build if none does).
const taglineHighlight = featured?.data.taglineHighlight;
if (featured && taglineHighlight) splitOnWord(featured.data.tagline, taglineHighlight);
const taglineSentences = (featured?.data.tagline ?? "").split(/(?<=[.!?])\s+/).map((sentence) => ({
  sentence,
  parts: taglineHighlight ? findWord(sentence, taglineHighlight) : undefined,
}));

const [mail, linkedIn] = contactLinks;

// The About card crossfades through these, in order (CSS only; see .photo-stack).
// `position` is the object-position that keeps the face centered in the 4:5 card.
const aboutPhotos = [
  {
    image: desertRide,
    alt: "Christopher Pombo smiling on a ride in the desert, helmet pushed up",
    position: "58% 30%",
  },
  {
    image: ocpBeret,
    alt: "Christopher Pombo in uniform and a blue beret, smiling and pointing up",
    position: "55% 30%",
  },
  {
    image: lake,
    alt: "Christopher Pombo smiling by a turquoise mountain lake, leaning on a railing",
    position: "50% 50%",
  },
];
// Card photo size at 1x; landscape photos get wider renders so they still fill the height.
const CARD_WIDTH = 260;
const CARD_HEIGHT = (CARD_WIDTH * 5) / 4;
const renderWidth = ({ width, height }: ImageMetadata) =>
  Math.max(CARD_WIDTH, Math.ceil((CARD_HEIGHT * width) / height));
---

<BaseLayout title="Christopher Pombo" description="Christopher Pombo — work and projects.">
  <section class="hero">
    <h1 class="hero__title"><Highlight color="green">Hi</Highlight>, I’m Christopher.</h1>
    <p class="hero__intro">Here’s a bit about me and the things I’m working on.</p>
  </section>

  <section class="section" id="about">
    <SectionHeading number="01" text="About" highlight={{ word: "About", color: "green" }} />
    <div class="about">
      <figure class="photo-card">
        <div class="photo-stack">
          {aboutPhotos.map((photo, i) => (
            <Image
              src={photo.image}
              alt={photo.alt}
              width={renderWidth(photo.image)}
              densities={[1, 2]}
              loading={i === 0 ? "eager" : "lazy"}
              style={`object-position: ${photo.position}`}
            />
          ))}
        </div>
      </figure>
      <p class="about__text">
        I like using math and analytical thinking to solve problems, and building things in my free time.
      </p>
    </div>
  </section>

  <section class="section" id="work">
    <SectionHeading number="02" text="Work" highlight={{ word: "Work", color: "blue" }}>
      <a slot="trailing" class="section-link" href="/projects">All projects →</a>
    </SectionHeading>

    {
      featured && (
        <div class="featured">
          <div class="featured__text">
            <h3 class="featured__title">{featured.data.title}</h3>
            <p class="featured__tagline">
              {taglineSentences.map(({ sentence, parts }, i) => (
                <>
                  {i > 0 && " "}
                  <span class="featured__sentence">
                    {parts ? <>{parts[0]}<Highlight color="yellow">{parts[1]}</Highlight>{parts[2]}</> : sentence}
                  </span>
                </>
              ))}
            </p>
            {featured.data.subtagline && <p class="featured__subtagline">{featured.data.subtagline}</p>}
            <div class="featured__actions">
              {appStore ? (
                <a class="btn btn--primary" href={appStore} target="_blank" rel="noopener noreferrer">
                  App Store
                </a>
              ) : (
                <p class="mono featured__soon">Coming soon to the App Store</p>
              )}
              <a class="text-link" href={`/projects/${featured.id}`}>
                Read the case study →
              </a>
            </div>
          </div>
          {shots.length > 0 && (
            <div class="featured__visual">
              <PhoneTrio shots={shots} width={300} />
            </div>
          )}
        </div>
      )
    }

    {
      others.length > 0 && (
        <ol class="project-list">
          {others.map((entry) => (
            <li>
              <a class="project-row" href={`/projects/${entry.id}`}>
                <span class="project-row__title">{entry.data.title}</span>
                <span class="project-row__tagline">{entry.data.tagline}</span>
                <span class="mono project-row__stack">{entry.data.stack.join(" · ")}</span>
                <span class="project-row__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      )
    }

    {
      projects.length === 1 && (
        <p class="next-project">
          <span class="next-project__title">Next project</span>
          <span class="mono next-project__note">More soon</span>
        </p>
      )
    }
  </section>

  <section class="section" id="contact">
    <SectionHeading number="03" text="Contact" highlight={{ word: "Contact", color: "pink" }} />
    <div class="contact-actions">
      <a class="btn btn--primary" href={mail.href}>Email</a>
      <a class="btn" href={linkedIn.href} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero: a quiet hello ---------- */
  .hero {
    padding-bottom: var(--space-7);
  }

  .hero__title {
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 600;
  }

  .hero__intro {
    margin-top: var(--space-2);
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  /* ---------- Shared section bits ---------- */
  .section {
    margin-bottom: var(--space-8);
  }

  .section:last-child {
    margin-bottom: 0;
  }

  .section-link {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--font-size-label);
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .section-link:hover {
    text-decoration: underline;
  }

  .text-link {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--font-size-meta);
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
  }

  .text-link:hover {
    color: var(--color-accent);
  }

  /* ---------- 01 About ---------- */
  /* Content under each section heading starts 48px below it (the heading's
     24px margin + 24px here), matching the Work block's top padding. About
     adds 4px because the 1.5deg tilt lifts the card's top corner about that
     much. The padding is on the row, not the card, so the blurb stays
     centered on the photo. */
  .about {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
    padding-top: calc(var(--space-4) + 4px);
  }

  .photo-card {
    margin: 0;
    background: var(--color-surface);
    border: var(--border);
    box-shadow: var(--shadow-hard);
    padding: var(--space-2);
    transform: rotate(1.5deg);
  }

  /* Three photos stacked in the card, crossfading: each holds ~5s, then fades
     into the next over 1s. One 15s cycle (3 photos x 5s); every photo runs the
     same keyframes, offset by 5s. Reduced motion shows only the first. */
  .photo-stack {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .photo-stack :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }

  .photo-stack :global(img:first-child) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .photo-stack :global(img) {
      animation: photo-cycle 15s infinite;
    }

    .photo-stack :global(img:nth-child(2)) {
      animation-delay: -10s;
    }

    .photo-stack :global(img:nth-child(3)) {
      animation-delay: -5s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-stack :global(img:not(:first-child)) {
      display: none;
    }
  }

  /* Visible 0–4s, fades out 4–5s, hidden until 14s, fades back in 14–15s. */
  @keyframes photo-cycle {
    0%,
    26.667% {
      opacity: 1;
    }

    33.333%,
    93.333% {
      opacity: 0;
    }

    100% {
      opacity: 1;
    }
  }

  .about__text {
    font-size: clamp(1.375rem, 1vw + 1rem, 1.5rem);
    line-height: 1.45;
    max-width: 32ch;
  }

  /* ---------- 02 Work ---------- */
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-6);
    align-items: center;
    padding-block: var(--space-4) var(--space-6);
  }

  .featured__title {
    font-size: clamp(2.5rem, 3vw + 1rem, 3.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-4);
  }

  .featured__tagline {
    font-size: clamp(1.25rem, 1vw + 1rem, 1.5rem);
    line-height: 1.35;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .featured__sentence {
    display: inline-block;
  }

  .featured__tagline:has(+ .featured__subtagline) {
    margin-bottom: var(--space-2);
  }

  .featured__subtagline {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  /* App Store status, then the case study link on its own line below. */
  .featured__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .featured__soon {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
  }

  .featured__visual {
    padding-top: var(--space-4);
  }

  .project-list {
    list-style: none;
    padding: var(--space-2) var(--space-5);
    background: var(--color-surface);
    border: var(--border);
  }

  .project-list li + li {
    border-top: var(--rule);
  }

  .project-row {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) auto auto;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
    text-decoration: none;
    color: inherit;
  }

  .project-row__title {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-ink);
    transition: color var(--transition-fast);
  }

  .project-row__tagline {
    color: var(--color-text-muted);
  }

  .project-row__stack {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .project-row__arrow {
    font-family: var(--font-mono);
    color: var(--color-accent);
  }

  .project-row:hover .project-row__title {
    color: var(--color-accent);
  }

  /* An empty slot for the next project: a dashed outline, no card. */
  .next-project {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    max-width: none;
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) dashed var(--color-ink);
  }

  .next-project__title {
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .next-project__note {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
  }

  /* ---------- 03 Contact ---------- */
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-4);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 820px) {
    .featured {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .project-row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "title arrow"
        "tagline tagline"
        "stack stack";
      gap: var(--space-1) var(--space-3);
    }

    .project-row__title {
      grid-area: title;
    }

    .project-row__tagline {
      grid-area: tagline;
    }

    .project-row__stack {
      grid-area: stack;
      margin-top: var(--space-1);
    }

    .project-row__arrow {
      grid-area: arrow;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-bottom: var(--space-6);
    }

    .about {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .photo-card {
      width: min(260px, 100%);
    }

    .project-list,
    .next-project {
      padding-inline: var(--space-4);
    }
  }
</style>
