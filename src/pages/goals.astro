---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Card from "../components/Card.astro";
import CardTitle from "../components/CardTitle.astro";
import { goalStats } from "../data/goal-stats";

const allGoals = await getCollection("goals");

const toward = allGoals
  .filter((entry) => entry.data.category === "active")
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const done = allGoals
  .filter((entry) => entry.data.category === "done")
  .sort(
    (a, b) =>
      b.data.date.valueOf() - a.data.date.valueOf() || (a.data.order ?? 99) - (b.data.order ?? 99)
  );

const visibleStats = goalStats.filter((stat) => stat.value !== null);

const otherInvolvements = [
  "Biking",
  "Swimming",
  "Ski/snowboard",
  "Climbing/hiking",
  "Jujitsu",
  "Scuba",
  "Academic tutoring",
  "Community volunteering",
];

const formatMonth = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
---

<BaseLayout
  title="Goals — Christopher Pombo"
  description="What I'm working toward right now, and what I've already done."
>
  <PageHeader title="Goals" subtitle="What I'm working toward right now, and what I've already done." />

  <nav class="section-nav" aria-label="Jump to section">
    <a class="btn" href="#toward">Working toward</a>
    <a class="btn" href="#done">Stacked Rocks</a>
  </nav>

  <section class="goal-section" id="toward">
    <SectionHeading number="01" text="Working toward">
      <span slot="trailing" class="mono section-count">{toward.length} in progress</span>
    </SectionHeading>
    <p class="section-lede">Everything here is in motion.</p>

    <div class="card-grid goal-grid">
      {
        toward.map((entry) => (
          <a class="card-link" id={entry.id} href={`/goals/${entry.id}`}>
            <Card>
              {entry.data.dateLabel && <p class="label goal-date">{entry.data.dateLabel}</p>}
              <CardTitle title={entry.data.title} />
              <p class="goal-summary">{entry.data.summary}</p>
              <div class="goal-footer">
                {entry.data.next && <span class="mono goal-next">Next: {entry.data.next}</span>}
                <ul class="chips">
                  <li>{entry.data.tag}</li>
                </ul>
              </div>
            </Card>
          </a>
        ))
      }
    </div>
  </section>

  <section class="goal-section" id="done">
    <SectionHeading number="02" text="Stacked Rocks" note="one at a time" />
    <p class="section-lede">The trophy case, newest first.</p>

    {
      visibleStats.length > 0 && (
        <div class="stat-strip" style={`--stat-count: ${visibleStats.length}`}>
          {visibleStats.map((stat) => (
            <div class="stat-cell">
              <p class="stat-value">{stat.value}</p>
              <p class="mono stat-label">{stat.label}</p>
            </div>
          ))}
        </div>
      )
    }

    <div class="card-grid goal-grid">
      {
        done.map((entry) => (
          <a class="card-link" id={entry.id} href={`/goals/${entry.id}`}>
            <Card>
              <div class="goal-top">
                <p class="mono goal-when">{entry.data.dateLabel ?? formatMonth(entry.data.date)}</p>
                <p class="label goal-result">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  {entry.data.result ?? <span class="visually-hidden">Done</span>}
                </p>
              </div>
              <CardTitle title={entry.data.title} />
              <p class="goal-summary">{entry.data.summary}</p>
              <div class="goal-footer">
                <ul class="chips">
                  <li>{entry.data.tag}</li>
                </ul>
              </div>
            </Card>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mix-section">
    <SectionHeading text="Also in the mix" />
    <ul class="chips">
      {otherInvolvements.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .section-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }

  .goal-section {
    margin-bottom: var(--space-8);
  }

  .section-count {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .section-lede {
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .goal-grid {
    grid-auto-rows: 1fr;
  }

  .card-link {
    scroll-margin-top: var(--space-5);
    min-width: 0;
  }

  .goal-date {
    margin-bottom: var(--space-2);
  }

  .goal-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .goal-when {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
  }

  .goal-result {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    white-space: nowrap;
  }

  .goal-summary {
    flex-grow: 1;
  }

  .goal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: var(--rule);
  }

  .goal-next {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
  }

  .stat-strip {
    display: grid;
    grid-template-columns: repeat(var(--stat-count, 4), minmax(0, 1fr));
    background: var(--color-surface);
    border: var(--border);
    margin-bottom: var(--space-5);
  }

  .stat-cell {
    padding: var(--space-4);
    border-left: var(--rule);
  }

  .stat-cell:first-child {
    border-left: none;
  }

  .stat-value {
    font-weight: 700;
    font-size: var(--font-size-h2);
    line-height: 1.2;
  }

  .stat-label {
    font-size: var(--font-size-label);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  .mix-section {
    margin-bottom: var(--space-4);
  }

  @media (max-width: 640px) {
    .goal-section {
      margin-bottom: var(--space-7);
    }

    .stat-strip {
      grid-template-columns: 1fr;
    }

    .stat-cell {
      border-left: none;
    }

    .stat-cell + .stat-cell {
      border-top: var(--rule);
    }
  }
</style>
