---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Card from "../components/Card.astro";
import CardTitle from "../components/CardTitle.astro";
import { goalStats } from "../data/goal-stats";

const allGoals = await getCollection("goals");

const toward = allGoals
  .filter((entry) => entry.data.category === "active")
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const done = allGoals
  .filter((entry) => entry.data.category === "done")
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const visibleStats = goalStats.filter((stat) => stat.value !== null);

const otherInvolvements = [
  "Biking",
  "Swimming",
  "Ski/snowboard",
  "Climbing/hiking",
  "Jujitsu",
  "Scuba",
  "Academic tutoring",
  "Community volunteering",
];
---

<BaseLayout
  title="Goals — Christopher Pombo"
  description="What I'm working toward right now, and what I've already done."
>
  <PageHeader title="Goals" subtitle="What I'm working toward right now, and what I've already done." />

  <nav class="section-nav" aria-label="Jump to section">
    <a href="#toward">Working toward</a>
    <a href="#done">Accomplished</a>
  </nav>

  <section class="goal-section" id="toward">
    <SectionHeading text="Working toward">
      <span slot="trailing" class="section-count">{toward.length} in progress</span>
    </SectionHeading>
    <p class="section-lede">Everything here is in motion.</p>

    <div class="card-grid goal-grid">
      {
        toward.map((entry) => (
          <a class="card-link" id={entry.id} href={`/goals/${entry.id}`}>
            <Card>
              {entry.data.dateLabel && <p class="goal-date">{entry.data.dateLabel}</p>}
              <CardTitle title={entry.data.title} />
              <p class="goal-summary">{entry.data.summary}</p>
              <div class="goal-footer">
                {entry.data.next && <span class="goal-next">Next: {entry.data.next}</span>}
                <span class="goal-tag">{entry.data.tag}</span>
              </div>
            </Card>
          </a>
        ))
      }
    </div>
  </section>

  <section class="goal-section" id="done">
    <SectionHeading text="Accomplished" />
    <p class="section-lede">The trophy case, newest first.</p>

    {
      visibleStats.length > 0 && (
        <div class="stat-strip" style={`--stat-count: ${visibleStats.length}`}>
          {visibleStats.map((stat) => (
            <div class="stat-cell">
              <span class="stat-rule" aria-hidden="true" />
              <p class="stat-value">{stat.value}</p>
              <p class="stat-label">{stat.label}</p>
            </div>
          ))}
        </div>
      )
    }

    <div class="card-grid goal-grid">
      {
        done.map((entry) => {
          const dateText =
            entry.data.dateLabel ??
            entry.data.date.toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
          return (
            <a class="card-link" id={entry.id} href={`/goals/${entry.id}`}>
              <Card>
                <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <p class="goal-date">{dateText}</p>
                <CardTitle title={entry.data.title} />
                <p class="goal-summary">{entry.data.summary}</p>
                <div class="goal-footer goal-footer--tag-only">
                  <span class="goal-tag">{entry.data.tag}</span>
                </div>
              </Card>
            </a>
          );
        })
      }
    </div>
  </section>

  <hr class="mix-divider" />

  <section class="mix-section">
    <h2 class="mix-heading">Also in the mix</h2>
    <ul class="mix-tags">
      {otherInvolvements.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .section-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .section-nav a {
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    border-radius: var(--radius-card);
    padding: var(--space-2) var(--space-5);
    font-weight: 700;
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-uppercase);
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .section-nav a:hover {
    background: var(--color-accent);
    color: var(--color-surface);
  }

  .goal-section {
    margin-bottom: var(--space-7);
  }

  .section-count {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-uppercase);
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .section-lede {
    color: var(--color-text-muted);
    margin-top: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .goal-grid {
    grid-auto-rows: 1fr;
  }

  .card-link {
    scroll-margin-top: var(--space-5);
    min-width: 0;
  }

  .card-link :global(.card) {
    position: relative;
  }

  .goal-date {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-uppercase);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .goal-summary {
    color: var(--color-text);
    margin-top: var(--space-2);
    flex-grow: 1;
  }

  .goal-footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .goal-footer--tag-only {
    justify-content: flex-start;
  }

  .goal-next {
    font-size: var(--font-size-meta);
    color: var(--color-text-muted);
  }

  .goal-tag {
    font-size: var(--font-size-meta);
    font-weight: 700;
    letter-spacing: var(--letter-spacing-uppercase);
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .check-icon {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 20px;
    height: 20px;
    color: var(--color-accent);
  }

  .stat-strip {
    display: grid;
    grid-template-columns: repeat(var(--stat-count, 4), 1fr);
    background: var(--color-surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    margin-bottom: var(--space-6);
  }

  .stat-cell {
    padding: var(--space-5) var(--space-4);
    border-left: 1px solid var(--color-border);
  }

  .stat-cell:first-child {
    border-left: none;
  }

  .stat-rule {
    display: block;
    width: 24px;
    height: 3px;
    background: var(--color-accent);
    margin-bottom: var(--space-3);
  }

  .stat-value {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--font-size-h2);
    color: var(--color-text);
  }

  .stat-label {
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  @media (max-width: 640px) {
    .stat-strip {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat-cell:nth-child(2n + 1) {
      border-left: none;
    }

    .stat-cell:nth-child(n + 3) {
      border-top: 1px solid var(--color-border);
    }
  }

  .mix-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .mix-section {
    margin-bottom: var(--space-7);
  }

  .mix-heading {
    font-size: var(--font-size-h3);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .mix-tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .mix-tags li {
    font-size: var(--font-size-meta);
    font-weight: 500;
    letter-spacing: var(--letter-spacing-uppercase);
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-1) var(--space-2);
    border-radius: 2px;
  }
</style>
